# Copy to server/.env and fill in. server/.env is git-ignored — never commit it.
ANTHROPIC_API_KEY=
# The agent's own key (NOT your personal wallet). Generate one with: cast wallet new
# Fund its address with a little testnet USDC for gas (faucet.circle.com).
AGENT_PRIVATE_KEY=
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
