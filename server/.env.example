# Local: copy to server/.env (git-ignored — never commit it).
# Vercel: add the same three as Environment Variables in the project settings.

ANTHROPIC_API_KEY=
# The agent's own key (NOT your personal wallet). Generate one with: cast wallet new
# Fund its address with a little testnet USDC for gas (faucet.circle.com).
AGENT_PRIVATE_KEY=
# Random secret (32+ chars) that signs sign-in sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional: gasless USDC sends through Circle's Facilitator Service.
# TEST_API_KEY:... for Arc Testnet, LIVE_API_KEY:... for mainnet. Unset = off.
CIRCLE_API_KEY=
PORT=8787
