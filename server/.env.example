# Local: copy to server/.env (git-ignored — never commit it).
# Vercel: add the same three as Environment Variables in the project settings.

ANTHROPIC_API_KEY=
# The agent's own key (NOT your personal wallet). Generate one with: cast wallet new
# Fund its address with a little testnet USDC for gas (faucet.circle.com).
AGENT_PRIVATE_KEY=
# Random secret (32+ chars) that signs sign-in sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional: gasless USDC sends through Circle's Facilitator Service.
# TEST_API_KEY:... for Arc Testnet, LIVE_API_KEY:... for mainnet. Unset = off.
CIRCLE_API_KEY=
PORT=8787

# Optional: card top-ups via Arc's hosted Onramp widget. The domain embedding it
# (e.g. vlora-two.vercel.app); defaults to the request host.
ONRAMP_REFERRER_DOMAIN=
# Optional: cashing out USDC to a bank account through Paycrest. From a verified
# sender account at app.paycrest.io. Mainnet only. Unset = the panel shows rates
# and bank lookups but can't create orders.
PAYCREST_API_KEY=
# Optional: a fee Vlora collects on each cash-out, settled on-chain by Paycrest.
# Both are needed for a fee; leave blank to charge nothing.
PAYCREST_FEE_PERCENT=
PAYCREST_FEE_ADDRESS=
# Optional: per-order ceiling in USDC (default 100).
OFFRAMP_MAX_USDC=
