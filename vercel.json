{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/agent/**": {
      "maxDuration": 120
    },
    "api/gasless/**": {
      "maxDuration": 60
    },
    "api/onramp/**": {
      "maxDuration": 30
    },
    "api/offramp/**": {
      "maxDuration": 30
    },
    "api/bills/**": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/rpc/mainnet",
      "destination": "https://rpc.mainnet.arc.io/"
    },
    {
      "source": "/rpc/testnet",
      "destination": "https://rpc.testnet.arc.io/"
    },
    {
      "source": "/lifi/:path*",
      "destination": "https://li.quest/v1/:path*"
    }
  ]
}
